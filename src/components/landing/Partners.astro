---
import { useTranslations, type Locale } from "../../i18n/utils";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="sec partners" id="suradnja">
	<div class="wrap">
		<div class="pstrip">
			<span class="pstrip-label">{t.partners.label}</span>
			<div class="pstrip-logos">
				<a href="https://kodelab.hr" target="_blank" rel="noopener" aria-label="Kodelab">
					<img
						class="pstrip-kodelab"
						src="/images/kodelab-logo.svg"
						alt="Kodelab"
						width="2311"
						height="323"
						loading="lazy"
					/>
				</a>
				<span class="pstrip-x" aria-hidden="true">×</span>
				<a href="https://mateh.hr/" target="_blank" rel="noopener" aria-label="Mateh Software">
					<img
						class="pstrip-mateh"
						src="/images/mateh-logo.png"
						alt="Mateh Software"
						width="253"
						height="90"
						loading="lazy"
					/>
				</a>
				<span class="pstrip-sep" aria-hidden="true"></span>
				<figure class="pstrip-person">
					<img
						src="/images/kresimir-dzelalija.png"
						alt=""
						width="754"
						height="1024"
						loading="lazy"
					/>
					<figcaption>{t.partners.ceo}</figcaption>
				</figure>
			</div>
		</div>
	</div>
</section>
