---
import { useTranslations, type Locale } from "../../i18n/utils";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="sec partners" id="suradnja">
	<div class="wrap">
		<div class="pstrip">
			<span class="pstrip-label">{t.partners.label}</span>
			<div class="pstrip-logos">
				<a href="https://kodelab.hr" target="_blank" rel="noopener" aria-label="Kodelab">
					<img src="/images/kodelab-znak-crno.png" alt="Kodelab" loading="lazy" />
				</a>
				<span class="pstrip-x" aria-hidden="true">×</span>
				<a href="https://mateh.hr/" target="_blank" rel="noopener" aria-label="Mateh Software">
					<img src="/images/mateh-logo.png" alt="Mateh Software" loading="lazy" />
				</a>
			</div>
		</div>
	</div>
</section>
