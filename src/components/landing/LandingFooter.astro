---
import LanguageSwitcher from "../ui/LanguageSwitcher.astro";
import { useTranslations, getLocalizedUrl, type Locale } from "../../i18n/utils";
import { APP_URL } from "../../consts";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const home = getLocalizedUrl(locale);
const year = new Date().getFullYear();

const columns = [
	{ title: t.footer.product, links: t.footer.productLinks },
	{ title: t.footer.company, links: t.footer.companyLinks },
	{ title: t.footer.legal, links: t.footer.legalLinks },
];

const resolve = (href: string) => {
	if (href.startsWith("#")) return `${home}${href}`;
	if (href.startsWith("/")) return getLocalizedUrl(locale, href);
	return href;
};
---

<footer class="site-footer">
	<div class="wrap">
		<div class="f-grid">
			<div class="f-brand">
				<a href={home} class="brand"><span class="brand-dot"></span>Luna</a>
				<p>{t.footer.description}</p>
				<LanguageSwitcher currentLocale={locale} class="f-lang" />
			</div>

			{
				columns.map((column) => (
					<div class="f-col">
						<h5>{column.title}</h5>
						{column.links.map((link) => (
							<a
								href={resolve(link.href)}
								{...("external" in link && link.external
									? { target: "_blank", rel: "noopener noreferrer" }
									: {})}
							>
								{link.label}
							</a>
						))}
					</div>
				))
			}

			<div class="f-col f-cta">
				<h5>{t.footer.ctaHeading}</h5>
				<a href={`${home}#kontakt`} class="btn btn-ink btn-sm" style="margin-bottom:10px;">
					{t.footer.ctaButton}
				</a>
				<a href={APP_URL} class="f-plain">{t.footer.appLink}</a>
			</div>
		</div>

		<div class="f-bot">
			<span>&copy; {year} {t.footer.copyright}</span>
		</div>
	</div>
</footer>
