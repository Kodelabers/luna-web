---
import Container from "../ui/Container.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import { useTranslations, type Locale } from "../../i18n/utils";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section id="team" class="py-16 sm:py-24 bg-white">
	<Container>
		<SectionHeading title={t.team.title} subtitle={t.team.subtitle} />

		<div class="mt-12 grid gap-6 md:grid-cols-2">
			<div class="rounded-2xl border border-gray-200 bg-gray-50 p-6 sm:p-8">
				<div class="flex flex-col gap-5 sm:flex-row sm:items-start">
					<img
						src="/images/kresimir-dzelalija.png"
						alt={t.team.ceoName}
						class="h-28 w-28 rounded-xl object-cover object-top border border-gray-200"
						loading="lazy"
					/>
					<div>
						<p class="text-sm font-semibold uppercase tracking-wide text-luna-700">
							{t.team.ceoLabel}
						</p>
						<p class="mt-2 text-2xl font-bold text-gray-900">{t.team.ceoName}</p>
						<p class="mt-3 text-gray-600 leading-relaxed">{t.team.ceoDescription}</p>
					</div>
				</div>
			</div>

			<div class="rounded-2xl border border-gray-200 bg-gray-50 p-6 sm:p-8">
				<div class="flex flex-col gap-5 sm:flex-row sm:items-start">
					<img
						src="/images/kodelab-znak-crno.png"
						alt="Kodelab"
						class="h-28 w-28 rounded-xl object-cover object-center border border-gray-200 bg-white p-2"
						loading="lazy"
					/>
					<div>
						<p class="text-sm font-semibold uppercase tracking-wide text-luna-700">
							{t.team.membersLabel}
						</p>
						<p class="mt-2 text-xl font-semibold text-gray-900">
							{t.team.membersTitlePrefix}{" "}
							<a
								href="https://kodelab.hr"
								target="_blank"
								rel="noopener noreferrer"
								class="text-luna-700 no-underline hover:text-luna-800 transition-colors"
							>
								{t.team.membersLinkLabel}
							</a>
							{t.team.membersTitleSuffix ? ` ${t.team.membersTitleSuffix}` : ""}
						</p>
						<p class="mt-3 text-gray-600 leading-relaxed">{t.team.membersDescription}</p>
					</div>
				</div>
			</div>
		</div>
	</Container>
</section>
