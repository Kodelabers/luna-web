---
import { useTranslations, type Locale } from "../../i18n/utils";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="sec" id="sigurnost" style="padding-top:0;">
	<div class="wrap">
		<span class="kicker">{t.security.kicker}</span>
		<h2 class="d2">{t.security.title}</h2>
		<p class="body-lg" style="margin-top:20px;">{t.security.lead}</p>
	</div>
</section>
