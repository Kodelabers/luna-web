---
import FeatureIcons from "../icons/FeatureIcons.astro";
import type { FeatureIconName } from "../icons/types";
import { useTranslations, type Locale } from "../../i18n/utils";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const icons: FeatureIconName[] = [
	"leave",
	"planning",
	"balance",
	"admin",
	"reports",
	"contractors",
];
---

<section class="sec" id="mogucnosti" style="padding-top:0;">
	<div class="wrap">
		<span class="kicker">{t.features.kicker}</span>
		<h2 class="d2">{t.features.title}</h2>
		<p class="body-lg" style="margin-top:18px;">{t.features.lead}</p>

		<div class="caps">
			{
				t.features.items.map((item, i) => (
					<div class="cap">
						<FeatureIcons name={icons[i]} class="cap-i" />
						<h4>{item.title}</h4>
						<p>{item.description}</p>
						{icons[i] === "contractors" && (
							<details class="cap-more">
								<summary>{t.features.moreLabel}</summary>
								<div class="cap-more-in">
									<p>{t.features.slotsNote}</p>
									<div class="cap-slots" aria-hidden="true">
										{t.features.slots.map((slot) => (
											<div class="cs-row">
												<span class="cs-nm">{slot.day}</span>
												<span class="cs-bar">
													<i style={`left:${slot.start}%;width:${slot.width}%`} />
												</span>
												<span class="cs-t">{slot.label}</span>
											</div>
										))}
									</div>
								</div>
							</details>
						)}
					</div>
				))
			}
		</div>
	</div>
</section>
