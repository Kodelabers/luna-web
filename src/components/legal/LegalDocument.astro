---
import LandingPage from "../../layouts/LandingPage.astro";
import LandingFooter from "../landing/LandingFooter.astro";
import { useTranslations, type Locale } from "../../i18n/utils";

interface Props {
	locale: Locale;
	doc: "terms" | "privacy";
}

const { locale, doc } = Astro.props;
const t = useTranslations(locale);
const content = t.legal[doc];
---

<LandingPage title={`${content.title} | Luna`} description={content.lead} locale={locale}>
	<section class="sec legal-doc">
		<div class="wrap" style="max-width:760px;">
			<h1 class="d2">{content.title}</h1>
			<p class="body-lg" style="margin-top:16px;">{content.lead}</p>

			<div class="legal-sections">
				{
					content.sections.map((section) => (
						<section>
							<h2>{section.heading}</h2>
							{section.bodyHtml ? (
								<p set:html={section.bodyHtml} />
							) : (
								<p>{section.body}</p>
							)}
						</section>
					))
				}
			</div>
		</div>
	</section>
	<LandingFooter locale={locale} />
</LandingPage>

<style>
	.legal-doc {
		padding-top: 0;
	}

	.legal-sections {
		margin-top: 48px;
		display: flex;
		flex-direction: column;
		gap: 36px;
	}

	.legal-sections h2 {
		font-size: 1.2rem;
		font-weight: 600;
		color: var(--ink);
	}

	.legal-sections p {
		margin-top: 10px;
		color: var(--ink-2);
		line-height: 1.6;
	}

	.legal-sections :global(a) {
		color: var(--signal-2);
	}
</style>
