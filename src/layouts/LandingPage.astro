---
import BaseHead from "../components/BaseHead.astro";
import Navbar from "../components/landing/Navbar.astro";
import type { Locale } from "../i18n/utils";

interface Props {
	title: string;
	description: string;
	locale: Locale;
}

const { title, description, locale } = Astro.props;
---

<!doctype html>
<html lang={locale}>
	<head>
		<BaseHead title={title} description={description} locale={locale} />
	</head>
	<body>
		<Navbar locale={locale} />
		<main>
			<slot />
		</main>
	</body>
</html>
