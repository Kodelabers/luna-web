---
import LandingPage from "../../layouts/LandingPage.astro";
import Hero from "../../components/landing/Hero.astro";
import Problem from "../../components/landing/Problem.astro";
import Roles from "../../components/landing/Roles.astro";
import HowItWorks from "../../components/landing/HowItWorks.astro";
import Features from "../../components/landing/Features.astro";
import Partners from "../../components/landing/Partners.astro";
import Security from "../../components/landing/Security.astro";
import CTA from "../../components/landing/CTA.astro";
import LandingFooter from "../../components/landing/LandingFooter.astro";
import { useTranslations } from "../../i18n/utils";

export const prerender = true;

const locale = "sl";
const t = useTranslations(locale);
---

<LandingPage title={t.meta.title} description={t.meta.description} locale={locale}>
	<Hero locale={locale} />
	<Problem locale={locale} />
	<Roles locale={locale} />
	<HowItWorks locale={locale} />
	<Features locale={locale} />
	<Partners locale={locale} />
	<Security locale={locale} />
	<CTA locale={locale} />
	<LandingFooter locale={locale} />
</LandingPage>
