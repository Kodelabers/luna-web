{
	"name": "luna-web",
	"account_id": "adc66b0503ca51d517fd18a5a83b6734",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./dist/_worker.js/index.js",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	// Throttles the public, unauthenticated /api/contact endpoint so it can't be
	// scripted into a spam relay (H1) — see src/pages/api/contact.ts.
	// `namespace_id` is just a local identifier Cloudflare uses to track this
	// limiter's state; it doesn't need to be provisioned anywhere.
	"ratelimits": [
		{
			"name": "CONTACT_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 5, "period": 60 }
		}
	]
}
